---
import type { ImageMetadata } from 'astro';
import GlassCard from '@/components/ui/GlassCard.astro';
import Picture from '@/components/ui/Picture.astro';

export interface Props {
  title: string;
  cover?: ImageMetadata;
  coverAlt?: string;
  role: string;
  year: number;
  href: string;
  /** Entry id, used to pair this card's cover with the case study's hero. */
  slug: string;
  index: number;
  showYear?: boolean;
}

const {
  title,
  cover,
  coverAlt = title,
  role,
  year,
  href,
  slug,
  index,
  showYear = true,
} = Astro.props;
---

<article class="project">
  <GlassCard href={href} padding="none" radius="xl" class="project__card">
    <div class="project__visual" transition:name={`project-image-${slug}`}>
      {
        cover && (
          <Picture
            src={cover}
            alt={coverAlt}
            widths={[400, 800, 1200]}
            sizes="(min-width: 900px) 33vw, 100vw"
            loading={index === 1 ? 'eager' : 'lazy'}
            fetchpriority={index === 1 ? 'high' : undefined}
            class="project__image"
          />
        )
      }
    </div>

    <div class="project__body">
      <div class="project__meta">
        {
          showYear && (
            <>
              <span>{year}</span>
              <span aria-hidden="true">/</span>
            </>
          )
        }
        <span>{role}</span>
      </div>

      <h2 class="project__title">{title}</h2>
    </div>
  </GlassCard>
</article>

<style>
  .project,
  .project__card {
    height: 100%;
  }

  .project__card {
    display: grid;
    grid-template-rows: auto 1fr;
  }

  .project__visual {
    position: relative;
    aspect-ratio: 2 / 3;
    overflow: hidden;
    background: var(--color-surface);
  }

  .project__visual :global(.project__image) {
    position: absolute;
    inset: 0;
    display: block;
    width: 100%;
    height: 100%;
    object-fit: cover;
    object-position: center;
  }

  .project__visual :global(.project__image img) {
    position: absolute;
    inset: 0;
    display: block;
    width: 100%;
    height: 100%;
    object-fit: cover;
    object-position: center;
  }

  .project__body {
    display: flex;
    flex-direction: column;
    padding: 1.25rem var(--space-md) var(--space-lg);
    border-top: 2px solid var(--brand-magenta);
  }

  .project__meta {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-sm);
    margin-bottom: 0.25rem;
    color: var(--color-text-muted);
    font-family: var(--font-mono);
    font-size: var(--text-xs);
    letter-spacing: 0.04em;
    text-transform: uppercase;
  }

  .project__title {
    margin-bottom: 0;
    color: var(--color-text);
    font-size: var(--text-3xl);
    line-height: 1.08;
  }
</style>
