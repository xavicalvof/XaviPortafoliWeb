---
import type { ImageMetadata } from 'astro';
import type { Language } from '@/lib/i18n';
import Picture from '@/components/ui/Picture.astro';
import ImageLightbox from './ImageLightbox.astro';
import { imagePresentation } from '@/lib/image-presentation';
export interface Props {
  language: Language;
}
const assets = import.meta.glob<{ default: ImageMetadata }>(
  '/src/assets/images/Galería/*',
  { eager: true },
);
// Preserve the existing gallery order and captions. Descriptive editorial alt
// text can be added here when supplied.
const captions = [
  ['Cafetal_07AM_1.55.1_1.50.1 (1).jpg', 'Cafetal 07AM'],
  ['Cafetal_11AM_1.55.1.jpg', 'Cafetal 11AM'],
  ['Cañon_I.Still (1).jpg', 'Cañón I'],
  ['ERA_HoraBruja_V2 (3).jpg', 'Hora Bruja'],
  ['HighresScreenshot00000 (1).png', 'Highres Screenshot 01'],
  ['HighresScreenshot00000 (2).png', 'Highres Screenshot 02'],
  ['image (6).png', 'Image 06'],
  ['image (7).png', 'Image 07'],
  ['LS_Filipinas_05_v001_0000 (1).jpeg', 'Filipinas 01'],
  ['LS_Filipinas_05_v006_0000 (3).jpeg', 'Filipinas 06'],
  ['LS_Ndisplay1.0000.v004 (1).jpeg', 'N Display 04'],
  ['LS_Ndisplay1.0000.v006 (2).jpeg', 'N Display 06'],
  ['LS_Ndisplay1.0000.v008 (1).jpeg', 'N Display 08'],
  ['PlayaDia_1.91.1 (1).jpg', 'Playa de día'],
  ['Playa_1.45.1 (1).jpg', 'Playa'],
  ['Untitled_1.81.1 (1).jpg', 'Untitled'],
];
const images = captions.map(([file, title]) => ({
  src: assets[`/src/assets/images/Galería/${file}`].default,
  title,
}));
---

<div class="gallery-grid">
  {
    images.map((image, index) => (
      <button
        type="button"
        class="gallery-tile"
        data-gallery-image
        data-src={image.src.src}
        data-ratio={imagePresentation(image.src).ratio}
        data-position={imagePresentation(image.src).position}
        data-title={image.title}
        aria-label={`${image.title} — ${index + 1}/${images.length}`}
        aria-haspopup="dialog"
      >
        <>
          <Picture
            src={image.src}
            alt={image.title}
            widths={[400, 800, 1200]}
            sizes="(min-width: 1000px) 30vw, (min-width: 600px) 46vw, 92vw"
          />
        </>
      </button>
    ))
  }
</div>
<ImageLightbox language={Astro.props.language} />
