---
import type { CollectionEntry } from 'astro:content';
import Container from '@/components/ui/Container.astro';
import Pagination from '@/components/blog/Pagination.astro';
import { withBase } from '@/lib/url';
import ProjectCard from './ProjectCard.astro';

export interface Props {
  projects: CollectionEntry<'projects'>[];
  totalProjects: number;
  currentPage: number;
  totalPages: number;
  perPage: number;
  showTechStack: boolean;
  showYear: boolean;
}

const {
  projects,
  currentPage,
  totalPages,
  perPage,
  showTechStack,
  showYear,
} = Astro.props;

const indexOffset = (currentPage - 1) * perPage;
---

<section class="work-hero" aria-labelledby="work-title">
  <Container size="xl">
    <h1 id="work-title">Proyectos</h1>
  </Container>
</section>

<section class="project-index" aria-labelledby="project-index-title">
  <Container size="xl">
    <h2 id="project-index-title" class="sr-only">Proyectos seleccionados</h2>

    {
      projects.length > 0 ? (
        <>
          <div class="project-grid-shell">
            <div class="project-grid">
              {projects.map((project, index) => (
                <div
                  class:list={[
                    'project-shell',
                  ]}
                  data-technologies={
                    showTechStack
                      ? JSON.stringify(project.data.tech)
                      : undefined
                  }
                >
                  <ProjectCard
                    title={project.data.title}
                    summary={project.data.summary}
                    cover={project.data.cover}
                    coverAlt={project.data.coverAlt}
                    tech={project.data.tech}
                    role={project.data.role}
                    year={project.data.year}
                    href={withBase(`/work/${project.id}/`)}
                    slug={project.id}
                    index={indexOffset + index + 1}
                    featured={project.data.featured}
                    showTechStack={showTechStack}
                    showYear={showYear}
                  />
                </div>
              ))}
            </div>
          </div>
          <Pagination
            currentPage={currentPage}
            totalPages={totalPages}
            basePath="/work"
          />
        </>
      ) : (
        <p class="empty-state">
          The archive is being assembled. Check back soon.
        </p>
      )
    }
  </Container>
</section>

<style>
  .work-hero {
    padding-block: clamp(5rem, 11vw, 10rem);
  }

  .work-hero :global(.container) {
    display: grid;
    grid-template-columns: minmax(5rem, 0.25fr) minmax(0, 1fr);
    gap: var(--space-xl);
  }

  .work-hero__index {
    padding-top: 0.65rem;
    color: var(--color-text-muted);
    font-family: var(--font-mono);
    font-size: var(--text-xs);
    letter-spacing: 0.08em;
  }

  .work-hero__content {
    max-width: 68rem;
  }

  .work-hero__eyebrow,
  .project-index__label {
    margin-bottom: var(--space-md);
    color: var(--color-accent);
    font-family: var(--font-mono);
    font-size: var(--text-xs);
    font-weight: 700;
    letter-spacing: 0.1em;
    text-transform: uppercase;
  }

  .work-hero h1 {
    max-width: 14ch;
    margin-bottom: var(--space-xl);
    font-size: clamp(3.25rem, 8.5vw, 8rem);
    font-weight: 750;
    line-height: 0.88;
    letter-spacing: -0.065em;
  }

  .work-hero h1 em {
    color: var(--color-accent);
    font-family: Georgia, 'Times New Roman', serif;
    font-weight: 400;
  }

  .work-hero__intro {
    max-width: 42rem;
    margin: 0 0 0 auto;
    color: var(--color-text-muted);
    font-size: var(--text-lg);
    line-height: 1.7;
  }

  .project-index {
    padding-bottom: var(--space-3xl);
  }

  .project-index__bar {
    display: flex;
    align-items: end;
    justify-content: space-between;
    gap: var(--space-xl);
    margin-bottom: var(--space-2xl);
    padding-bottom: var(--space-lg);
    border-bottom: 1px solid var(--glass-border);
  }

  .project-index__bar h2 {
    margin: 0;
    font-size: var(--text-3xl);
  }

  .filters {
    display: flex;
    flex-wrap: wrap;
    justify-content: flex-end;
    gap: var(--space-xs);
  }

  .filter {
    min-height: 2.75rem;
    padding: var(--space-xs) var(--space-md);
    border: 1px solid var(--glass-border);
    border-radius: var(--radius-full);
    color: var(--color-text-muted);
    background: color-mix(in srgb, var(--color-surface) 70%, transparent);
    font-size: var(--text-sm);
    transition:
      color var(--transition-fast),
      border-color var(--transition-fast),
      background var(--transition-fast);
  }

  .filter.is-active {
    border-color: var(--color-accent);
    color: var(--color-accent);
    background: var(--color-accent-glass);
  }

  @media (hover: hover) {
    .filter:hover {
      border-color: var(--color-accent);
      color: var(--color-accent);
      background: var(--color-accent-glass);
    }
  }

  .filter:focus-visible {
    outline: 2px solid var(--color-accent);
    outline-offset: 2px;
  }

  /* The grid can't query its own width, so the shell is the container. */
  .project-grid-shell {
    container-type: inline-size;
  }

  .project-grid {
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    gap: var(--space-xl);
  }

  /* Collapse only when the content container becomes narrow. */
  @container (max-width: 768px) {
    .project-grid {
      grid-template-columns: 1fr;
    }

  }

  .project-shell[hidden] {
    display: none;
  }

  .empty-state {
    padding: var(--space-3xl);
    border: 1px solid var(--glass-border);
    border-radius: var(--radius-xl);
    color: var(--color-text-muted);
    text-align: center;
  }

  @media (max-width: 768px) {
    .work-hero :global(.container) {
      display: block;
    }

    .work-hero__index {
      margin-bottom: var(--space-xl);
    }

    .work-hero__intro {
      margin-left: 0;
    }

    .project-index__bar {
      display: block;
    }

    .filters {
      justify-content: flex-start;
      margin-top: var(--space-xl);
    }
  }
</style>
