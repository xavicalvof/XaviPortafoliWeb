---
import { pageLanguage, localLink } from '@/lib/portfolio';
import { getTranslations } from '@/lib/i18n';
const language = pageLanguage(Astro.url);
---

<footer class="site-footer" data-pagefind-ignore>
  <div class="portfolio-container footer-row">
    <a href={localLink('/', language)}>Xavi Calvo</a><a
      href={localLink('/contact/', language)}
      >{getTranslations(language).contact} ↗</a>
  </div>
</footer>
<style>
  .site-footer {
    margin-top: auto;
    padding-top: 48px;
  }
  .footer-row {
    display: flex;
    justify-content: space-between;
    gap: 24px;
    border-top: 1px solid var(--glass-border);
    padding-block: 24px 32px;
    font-size: 14px;
  }
  a {
    color: var(--color-text);
  }
</style>
