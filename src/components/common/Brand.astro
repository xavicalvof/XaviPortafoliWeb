---
import symbol from '@/assets/Logos/xavi-calvo-svg/simbol.svg';
import name from '@/assets/Logos/xavi-calvo-svg/nom.svg';
---

<span class="brand-logo">
  <img src={symbol.src} alt="" width="282" height="302" />
  <img src={name.src} alt="Xavi Calvo" width="268" height="302" />
</span>

<style>
  .brand-logo {
    display: inline-flex;
    align-items: center;
    gap: 20px;
  }
  .brand-logo img {
    height: 64px;
    width: auto;
  }
  @media (max-width: 1100px) {
    .brand-logo {
      gap: 18px;
    }
    .brand-logo img {
      height: 56px;
    }
  }
</style>
