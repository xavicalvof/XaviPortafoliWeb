---
import Brand from './Brand.astro';
import { getTranslations } from '@/lib/i18n';
import { pageLanguage, localLink, plainPath, copy } from '@/lib/portfolio';
export interface Props {
  overlay?: boolean;
}
const { overlay = false } = Astro.props;
const language = pageLanguage(Astro.url);
const nav = getTranslations(language).nav;
const path = plainPath(Astro.url.pathname);
const active = (href: string) =>
  href === '/' ? path === '/' : path.startsWith(href);
---

<header
  class:list={['site-header', { 'site-header--overlay': overlay }]}
  data-pagefind-ignore
>
  <div class="header-container">
    <a
      href={localLink('/', language)}
      class="brand"
      aria-label={`Xavi Calvo — ${nav['/']}`}><Brand /></a
    >
    <button
      class="menu-toggle"
      aria-expanded="false"
      aria-controls="navigation"
      aria-label={copy[language].menu}
      ><span></span><span></span><span></span></button
    >
    <nav id="navigation" aria-label={copy[language].menu}>
      <ul class="nav-list">
        {
          Object.entries(nav).map(([href, label]) => (
            <li>
              <a
                class:list={['nav-link', { active: active(href) }]}
                aria-current={active(href) ? 'page' : undefined}
                href={localLink(href, language)}
              >
                {label}
              </a>
            </li>
          ))
        }
      </ul>
      <div class="mobile-languages">
        {
          (['es', 'en', 'ca'] as const).map((lang) => (
            <a
              href={localLink(path, lang)}
              lang={lang}
              aria-current={lang === language ? 'true' : undefined}
            >
              {lang.toUpperCase()}
            </a>
          ))
        }
      </div>
    </nav>
    <nav class="language-picker" aria-label="Language">
      {
        (['es', 'en', 'ca'] as const).map((lang) => (
          <a
            href={localLink(path, lang)}
            lang={lang}
            aria-current={lang === language ? 'true' : undefined}
          >
            {lang.toUpperCase()}
          </a>
        ))
      }
    </nav>
  </div>
</header>
<style>
  .site-header {
    position: relative;
    z-index: 30;
    background: var(--color-bg);
  }
  .site-header--overlay {
    position: absolute;
    inset: 0 0 auto;
    background: linear-gradient(#08090bdd, transparent);
  }
  .header-container {
    min-height: 108px;
    padding: 16px 4vw;
    display: grid;
    grid-template-columns: 1fr auto 1fr;
    align-items: center;
    gap: 24px;
  }
  .brand {
    justify-self: start;
    display: block;
  }
  .nav-list {
    display: flex;
    align-items: center;
    gap: clamp(18px, 2.3vw, 38px);
    list-style: none;
    margin: 0;
    padding: 0;
  }
  li {
    margin: 0;
  }
  a {
    color: var(--color-text);
  }
  .nav-link {
    display: inline-flex;
    align-items: center;
    min-height: 44px;
    position: relative;
    font-size: 13px;
    text-transform: uppercase;
    white-space: nowrap;
  }
  a:hover,
  a[aria-current] {
    color: var(--brand-lime);
    text-decoration: none;
  }
  .nav-link.active::after {
    content: '';
    height: 2px;
    width: 28px;
    background: var(--brand-magenta);
    position: absolute;
    bottom: 0;
    left: 50%;
    transform: translateX(-50%);
  }
  .language-picker {
    justify-self: end;
    display: flex;
    gap: 12px;
    font-size: 13px;
  }
  .language-picker a,
  .mobile-languages a {
    display: grid;
    place-items: center;
    min-width: 30px;
    min-height: 44px;
  }
  .menu-toggle,
  .mobile-languages {
    display: none;
  }
  @media (max-width: 1100px) {
    .header-container {
      min-height: 88px;
      grid-template-columns: 1fr auto;
    }
    .menu-toggle {
      display: flex;
      width: 48px;
      height: 48px;
      flex-direction: column;
      justify-content: center;
      gap: 6px;
      padding: 12px;
      background: transparent;
      border: 1px solid var(--glass-border);
    }
    .menu-toggle span {
      display: block;
      width: 22px;
      height: 2px;
      background: var(--color-text);
    }
    #navigation {
      display: none;
      grid-column: 1 / -1;
      padding-bottom: 20px;
    }
    .site-header:has([aria-expanded='true']) {
      background: var(--color-bg);
    }
    #navigation.open {
      display: block;
    }
    .nav-list {
      flex-direction: column;
      gap: 8px;
    }
    .language-picker {
      display: none;
    }
    .mobile-languages {
      display: flex;
      justify-content: center;
      gap: 24px;
      margin-top: 20px;
    }
  }
</style>
<script>
  import { onPage } from '@/lib/lifecycle';
  onPage(() => {
    const toggle = document.querySelector<HTMLButtonElement>('.menu-toggle');
    const nav = document.getElementById('navigation');
    const close = () => {
      toggle?.setAttribute('aria-expanded', 'false');
      nav?.classList.remove('open');
    };
    toggle?.addEventListener('click', () => {
      const open = toggle.getAttribute('aria-expanded') !== 'true';
      toggle.setAttribute('aria-expanded', String(open));
      nav?.classList.toggle('open', open);
    });
    nav?.addEventListener('keydown', (event) => {
      if (event.key === 'Escape') {
        close();
        toggle?.focus();
      }
    });
    toggle?.addEventListener('keydown', (event) => {
      if (event.key === 'Escape') close();
    });
    nav?.addEventListener('focusout', () => {
      requestAnimationFrame(() => {
        if (
          !nav.contains(document.activeElement) &&
          document.activeElement !== toggle
        )
          close();
      });
    });
  });
</script>
