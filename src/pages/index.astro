---
import BaseLayout from '@/layouts/BaseLayout.astro';
import Header from '@/components/common/Header.astro';
---

<BaseLayout
  title="Xavi Calvo | Portfolio"
  description="Portfolio personal de Xavi Calvo"
>
  <Header overlay />

  <main id="main" tabindex="-1">
    <section class="home-hero" aria-label="Presentación"></section>
  </main>
</BaseLayout>

<style>
  main {
    min-height: 100dvh;
  }

  .home-hero {
    position: relative;
    height: 100dvh;
    min-height: 32rem;
    overflow: hidden;
    background: #000;
  }
</style>
