---
import { getCollection } from 'astro:content';
import BaseLayout from '@/layouts/BaseLayout.astro';
import Header from '@/components/common/Header.astro';
import Footer from '@/components/common/Footer.astro';
import WorkArchive from '@/components/portfolio/WorkArchive.astro';
import siteConfig from '@/site.config';

const projectOrder = [
  'fieldnote-research-library',
  'interval-health-companion',
  'afterlight-cultural-archive',
  'northstar-civic-platform',
  'morrow-studio',
];
const allProjects = (await getCollection('projects')).sort(
  (a, b) => projectOrder.indexOf(a.id) - projectOrder.indexOf(b.id),
);
const perPage = Math.max(1, Math.floor(siteConfig.portfolio.projectsPerPage));
const totalPages = Math.max(1, Math.ceil(allProjects.length / perPage));
const projects = allProjects.slice(0, perPage);
---

<BaseLayout
  title="Work"
  description="Selected product, brand, and digital experience work from Astro Haze."
>
  <Header />

  <main id="main" tabindex="-1">
    <WorkArchive
      projects={projects}
      totalProjects={allProjects.length}
      currentPage={1}
      totalPages={totalPages}
      perPage={perPage}
      showTechStack={siteConfig.portfolio.showTechStack}
      showYear={siteConfig.portfolio.showYear}
    />
  </main>

  <Footer />
</BaseLayout>
