---
import BaseLayout from '@/layouts/BaseLayout.astro';
import Header from '@/components/common/Header.astro';
import Footer from '@/components/common/Footer.astro';
import Container from '@/components/ui/Container.astro';
---

<BaseLayout title="Galería" description="Galería visual de Xavi Calvo">
  <Header />

  <main id="main" tabindex="-1">
    <section class="gallery-heading">
      <Container size="xl">
        <p class="gallery-heading__label">Galería</p>
      </Container>
    </section>

    <section class="gallery-grid" aria-label="Galería de imágenes">
      <div class="gallery-tile gallery-tile--red"></div>
      <div class="gallery-tile gallery-tile--blue"></div>
      <div class="gallery-tile gallery-tile--yellow"></div>
      <div class="gallery-tile gallery-tile--green"></div>
      <div class="gallery-tile gallery-tile--pink"></div>
      <div class="gallery-tile gallery-tile--orange"></div>
      <div class="gallery-tile gallery-tile--violet"></div>
      <div class="gallery-tile gallery-tile--teal"></div>
    </section>
  </main>

  <Footer />
</BaseLayout>

<style>
  .gallery-heading { padding-block: clamp(5rem, 11vw, 9rem) var(--space-xl); }

  .gallery-heading__label {
    margin-bottom: var(--space-lg);
    color: var(--color-accent);
    font-family: var(--font-mono);
    font-size: var(--text-sm);
    text-transform: uppercase;
  }

  .gallery-grid {
    display: grid;
    grid-template-columns: repeat(4, 1fr);
    grid-auto-rows: minmax(8rem, 16vw);
    gap: 0.75rem;
    padding: 0 var(--space-lg) var(--space-3xl);
  }

  .gallery-tile {
    min-height: 8rem;
  }

  .gallery-tile--red { background: #d94f45; }
  .gallery-tile--blue { background: #3d6fd6; grid-row: span 2; }
  .gallery-tile--yellow { background: #f0c84b; }
  .gallery-tile--green { background: #4c8b68; grid-column: span 2; }
  .gallery-tile--pink { background: #d98da9; grid-row: span 2; }
  .gallery-tile--orange { background: #db7542; }
  .gallery-tile--violet { background: #7964aa; grid-column: span 2; }
  .gallery-tile--teal { background: #3b9690; }

  @media (max-width: 640px) {
    .gallery-grid {
      grid-template-columns: repeat(2, 1fr);
      grid-auto-rows: 30vw;
      padding-inline: var(--space-md);
    }
  }
</style>