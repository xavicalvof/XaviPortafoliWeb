---
import BaseLayout from '@/layouts/BaseLayout.astro';
import Header from '@/components/common/Header.astro';
import Footer from '@/components/common/Footer.astro';
import Container from '@/components/ui/Container.astro';
import { getLanguage, getTranslations } from '@/lib/i18n';
const translations = getTranslations(getLanguage(Astro.url.searchParams.get('lang')));
---

<BaseLayout title="Sobre mí" description="Conoce la trayectoria de Xavi Calvo">
  <Header />
  <main id="main" tabindex="-1">
    <section class="about-page">
      <Container size="md">
        <h1 class="page-title page-heading" data-i18n="about">{translations.about}</h1>
        <div class="about-content">
          <div class="about-photo" role="img" aria-label="Fotografía de Xavi Calvo"></div>
          <div class="about-copy">
          <p>
            {translations.aboutText1}
          </p>
          <p>
            {translations.aboutText2}
          </p>
          </div>
        </div>
      </Container>
    </section>
  </main>
  <Footer />
</BaseLayout>

<style>
  .about-page { padding-block: 0 var(--space-3xl); }
  .about-page :global(.container) {
    display: block;
  }
  .about-content {
    display: grid;
    grid-template-columns: minmax(14rem, 0.8fr) minmax(0, 1fr);
    gap: clamp(2rem, 8vw, 7rem);
    align-items: center;
  }
  .about-photo { aspect-ratio: 4 / 5; background: #536b8f; }
  .about-copy { max-width: 38rem; }
  .about-copy h1 { margin-bottom: var(--space-xl); }
  .about-copy p {
    color: var(--color-text-muted);
    font-size: var(--text-lg);
  }
  @media (max-width: 700px) {
    .about-content { grid-template-columns: 1fr; }
    .about-photo { max-width: 20rem; }
  }
</style>
